---
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Illummedia connects businesses, creators, and suppliers to discover opportunities and build together." />
    <meta name="theme-color" content="#111111" />
    <title>Illummedia — Build visibility. Create opportunities.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--ink:#111;--muted:#666b70;--paper:#f7f7f3;--yellow:#f5dc20;--line:#e6e6df;--white:#fff}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.nav{height:82px;display:flex;align-items:center;justify-content:space-between}.brand{font:800 25px 'Manrope',sans-serif;letter-spacing:-1.3px;color:#111}.brand .illum{color:#e5c900}.brand .dot{color:#111}.navlinks{display:flex;align-items:center;gap:30px;font-size:14px;color:#555}.navcta,.btn{background:var(--yellow);border:1px solid var(--yellow);border-radius:999px;padding:13px 20px;font-weight:700;font-size:14px;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.navcta:hover,.btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px #d4bd2738}.hero{background:#111;color:white;border-radius:28px;overflow:hidden;position:relative;padding:84px 7%;min-height:520px;display:grid;grid-template-columns:1.08fr .92fr;gap:40px;align-items:center}.hero:after{content:'';position:absolute;width:520px;height:520px;border-radius:50%;border:1px solid #ffffff12;right:-110px;top:-110px;box-shadow:0 0 0 50px #ffffff08,0 0 0 100px #ffffff05;pointer-events:none}.eyebrow{color:var(--yellow);font-size:12px;letter-spacing:2.4px;text-transform:uppercase;font-weight:700}.hero h1{font:800 clamp(42px,6vw,72px)/1.04 'Manrope',sans-serif;letter-spacing:-3px;margin:18px 0}.hero h1 span{color:var(--yellow)}.hero p{color:#c7c7c7;font-size:17px;line-height:1.7;max-width:520px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn.secondary{background:transparent;color:white;border-color:#555}.visual{position:relative;min-height:320px;display:grid;place-items:center}.orb{width:270px;height:270px;border-radius:50%;border:1px solid #f5dc2055;display:grid;place-items:center;box-shadow:0 0 80px #f5dc2015,inset 0 0 70px #f5dc2010;position:relative}.orb:before,.orb:after{content:'';position:absolute;border:1px solid #f5dc2040;border-radius:50%;inset:24px}.orb:after{inset:52px}.core{width:112px;height:112px;border-radius:30px;background:var(--yellow);color:#111;display:grid;place-items:center;font:800 48px 'Manrope';transform:rotate(-8deg);box-shadow:0 20px 60px #f5dc2038}.node{position:absolute;background:#222;border:1px solid #4c4c42;border-radius:14px;padding:12px 15px;font-size:12px;color:#eee;box-shadow:0 12px 35px #0008}.node b{display:block;color:var(--yellow);font-size:13px;margin-bottom:3px}.n1{top:16px;left:0}.n2{top:55px;right:-5px}.n3{bottom:25px;left:5px}.n4{bottom:0;right:8px}.section{padding:90px 0}.sectionhead{max-width:650px;margin-bottom:34px}.sectionhead .eyebrow{color:#9c8a00}.section h2{font:800 clamp(32px,4vw,48px)/1.1 'Manrope';letter-spacing:-1.8px;margin:12px 0}.sectionhead p{color:var(--muted);line-height:1.7}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.card{background:white;border:1px solid var(--line);border-radius:20px;padding:24px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between}.symbol{width:44px;height:44px;border-radius:14px;background:#fff6b5;display:grid;place-items:center;font-size:21px}.card h3{font:700 20px 'Manrope';margin:24px 0 8px}.card p{color:var(--muted);font-size:14px;line-height:1.6;margin:0}.alliance{background:#ecece5;border-radius:26px;padding:48px;display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}.alliance h2{margin-top:8px}.steps{display:grid;gap:12px}.step{background:#fff;border:1px solid #deded5;border-radius:15px;padding:17px;display:flex;gap:14px;align-items:flex-start}.num{width:28px;height:28px;border-radius:50%;background:var(--yellow);display:grid;place-items:center;font-weight:800;flex:none}.step p{margin:0;color:#565a5d;font-size:14px;line-height:1.55}.cta{background:#111;color:white;border-radius:26px;padding:55px;text-align:center}.cta h2{font:800 clamp(32px,4vw,48px)/1.1 'Manrope';letter-spacing:-1.5px;margin:12px auto;max-width:700px}.cta p{color:#c7c7c7;line-height:1.7;max-width:560px;margin:14px auto 26px}.footer{padding:30px 0 42px;display:flex;justify-content:space-between;gap:20px;color:#777;font-size:12px}.footer strong{color:#222}.smallnote{font-size:12px;color:#777;margin-top:14px}
      @media(max-width:850px){.hero{grid-template-columns:1fr;padding:58px 7% 30px}.visual{min-height:300px}.grid{grid-template-columns:repeat(2,1fr)}.alliance{grid-template-columns:1fr;padding:32px}.navlinks a:not(.navcta){display:none}}
      @media(max-width:520px){.wrap{width:min(100% - 26px,1160px)}.nav{height:70px}.brand{font-size:22px}.navcta{padding:11px 14px;font-size:12px}.hero{border-radius:20px;padding:48px 24px 20px;min-height:0}.hero h1{letter-spacing:-2px}.hero p{font-size:15px}.visual{min-height:270px;transform:scale(.88);margin:-8px -18px}.grid{grid-template-columns:1fr}.card{min-height:180px}.section{padding:65px 0}.alliance{padding:25px 20px}.cta{padding:42px 22px}.footer{flex-direction:column}}
    </style>
  </head>
  <body>
    <header class="wrap nav">
      <a class="brand" href="#top" aria-label="Illummedia home"><span class="illum">I</span><span class="dot">llummedia</span></a>
      <nav class="navlinks" aria-label="Main navigation"><a href="#top">Home</a><a href="#businesses">LLM Seo</a><a href="#creators">Creators</a><a href="#suppliers">Industrial</a>
<!-- <a href="#collaborate">Collaborate</a> -->
<a href="#portfolio">Portfolio</a><a class="navcta" href="#connect">Join early access ↗</a></nav>
    </header>
    <main id="top" class="wrap">
      <section class="hero">
        <div>
          <div class="eyebrow">The business &amp; creator collaboration platform</div>
          <h1>Build visibility.<br/><span>Create opportunities.</span><br/>Collaborate &amp; grow.</h1>
          <p>Illummedia connects businesses, creators, and suppliers to improve discoverability, reach the right audiences, and build valuable strategic alliances.</p>
          <div class="actions"><a class="btn" href="#connect">Explore early access ↗</a><a class="btn secondary" href="#ecosystem">Discover the ecosystem</a></div>
        </div>
        <div class="visual" aria-label="Illustration of connected participants">
          <div class="orb"><div class="core">I</div></div>
          <div class="node n1"><b>Businesses</b>Grow visibility</div><div class="node n2"><b>Creators</b>Reach audiences</div><div class="node n3"><b>Suppliers</b>Find opportunities</div><div class="node n4"><b>Partners</b>Build together</div>
        </div>
      </section>
      <section id="ecosystem" class="section">
        <div class="sectionhead"><div class="eyebrow">One ecosystem · Many ways to connect</div><h2>Bring the right people into the same network.</h2><p>Whether you're growing a company, building an audience, or supplying products and services, Illummedia is designed to make meaningful connections easier to discover.</p></div>
        <div class="grid">
          <article id="businesses" class="card"><div><div class="symbol">◈</div>
<h3>LLM Seo</h3>
<p>Strengthen your digital presence and become easier for relevant customers and collaborators to discover.</p>
<a
  href="/business"
  target="_blank"
  rel="noopener noreferrer"
  class="card-button"
>
  Explore <span>↗</span>
</a>
</div></article>
          <article id="creators" class="card"><div><div class="symbol">✳</div><h3>Creators</h3><p>Build a home for your work and make it easier for audiences and potential partners to find you.</p>
<br/>
<a
  href="/creators"
  target="_blank"
  rel="noopener noreferrer"
  class="card-button"
>
  Explore <span>↗</span>
</a>
</div></article>
          <article id="suppliers" class="card"><div><div class="symbol">▦</div><h3>Industrial</h3><p>Showcase what you offer and connect with businesses looking for products, expertise, and services.</p>
<a
  href="/suppliers"
  target="_blank"
  rel="noopener noreferrer"
  class="card-button"
>
  Explore <span>↗</span>
</a>
</div></article>

        <!--  <article id="collaborators" class="card"><div><div class="symbol">⌘</div><h3>Collaborators</h3><p>Discover complementary capabilities and explore opportunities to create value together.</p>
<a
  href="/collaborators"
  target="_blank"
  rel="noopener noreferrer"
  class="card-button"
>
  Explore <span>↗</span>
</a>
</div></article> -->
        </div> 
      </section> 
      <section id="collaborate" class="section" style="padding-top:0">
        <div class="alliance">
          <div><div class="eyebrow">Collaboration &amp; strategic alliances</div><h2>Build stronger connections together.</h2><p style="color:#62666a;line-height:1.7">Illummedia creates space for businesses, creators, suppliers, and independent professionals to discover shared needs, combine capabilities, and develop strategic alliances around meaningful opportunities.</p><a class="btn" href="#connect">Explore collaboration ↗</a></div>
          <div class="steps"><div class="step"><span class="num">1</span><p><strong>Discover</strong><br/>Find businesses, creators, suppliers, and useful capabilities.</p></div><div class="step"><span class="num">2</span><p><strong>Connect</strong><br/>Start conversations around shared interests and needs.</p></div><div class="step"><span class="num">3</span><p><strong>Collaborate</strong><br/>Explore projects, partnerships, and collective opportunities.</p></div></div>
        </div>
      </section>
      <section id="portfolio" class="section" style="padding-top:0">
        <div class="sectionhead"><div class="eyebrow">Portfolio</div><h2>Ideas, experiences, and work in progress.</h2><p>Explore the digital experiences and collaborative concepts taking shape across the Illummedia ecosystem. More showcases will be added as projects are released.</p></div>
        <div class="grid">
          <article class="card"><div><div class="symbol">◈</div><h3>Business visibility</h3><p>Digital experiences focused on discoverability, online presence, and growth.</p></div></article>
          <article class="card"><div><div class="symbol">✳</div><h3>Creator experiences</h3><p>Tools and experiences designed to help creators connect with their audiences.</p></div></article>
          <article class="card"><div><div class="symbol">▦</div><h3>Collaboration tools</h3><p>Concepts for bringing complementary businesses and capabilities together.</p></div></article>
          <article class="card"><div><div class="symbol">＋</div><h3>Vid Chronicles</h3>
            <p>A notification app designed to connect creators with audiences by sending them notifications whenever new content created by Vid Chronicles drop.</p>
        </div>
          <a class="btn" href="https://vid-chronicles--client-demo.expo.app/login"
     target="_blank" rel="noopener noreferrer">
    Explore Demo ↗
  </a>
</article>
        </div>
      </section>
      <section id="connect" class="section" style="padding-top:0">
        <div class="cta"><div class="eyebrow">Early community</div><h2>Help shape what we build next.</h2><p>Illummedia is developing its connected business and creator ecosystem. Tell us what you do and what kinds of connections would be valuable to you.</p><a class="btn" href="mailto:hello@YOURDOMAIN.com?subject=Illummedia%20Early%20Access">Contact Illummedia ↗</a><div class="smallnote">Replace hello@YOURDOMAIN.com with an email address you control before launch.</div></div>
      </section>
    </main>
    <footer class="wrap footer"><div><strong>Illummedia</strong> · Connect. Collaborate. Grow.</div><div>© {year} Illummedia. All rights reserved.</div></footer>
  </body>
</html>
